# NoneBot2 运行配置（复制为 .env 后使用）

# 监听地址与端口，NapCat 的反向 WS 要指向 ws://127.0.0.1:8080/onebot/v11/ws
HOST=127.0.0.1
PORT=8080

# 命令前缀，可写多个
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# 超级用户 QQ 号，拥有全部管理权限
SUPERUSERS=["10001"]

# OneBot 通信密钥，需与 NapCat 中的 token 保持一致（不设则留空）
ONEBOT_ACCESS_TOKEN=

# 日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO
