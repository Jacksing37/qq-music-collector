# NoneBot2 运行配置（复制为 .env 后使用）

# 监听地址与端口。
# - NapCat 与机器人同机且都在宿主机（非 Docker）：可填 127.0.0.1，反向 WS 用 ws://127.0.0.1:8080/onebot/v11/ws
# - NapCat 在 Docker、机器人原生跑在宿主机（混合部署）：必须填 0.0.0.0，
#   否则容器经 host.docker.internal(→172.17.0.1 网桥) 连不进来，报 ECONNREFUSED。
HOST=0.0.0.0
PORT=8080

# 命令前缀，可写多个
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# 超级用户 QQ 号，拥有全部管理权限
SUPERUSERS=["10001"]

# OneBot 通信密钥，需与 NapCat 中的 token 保持一致（不设则留空）
ONEBOT_ACCESS_TOKEN=

# 日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 配置管理 Web UI 访问令牌（强烈建议设置）。
# 访问 http://<本机IP>:8080/music-admin 时需要它；未设置则每次启动随机生成并打印在日志里。
# 注意：机器人 HOST=0.0.0.0 时 8080 会暴露在所有网卡，务必设置此令牌并配合防火墙。
MUSIC_WEBUI_TOKEN=
