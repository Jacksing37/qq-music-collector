# ===== 依赖 / 构建产物 =====
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# ===== 密钥与凭证（切勿提交！） =====
# 包含 NoneBot 配置与 OneBot 通信密钥
.env
# QQ 协议端（NapCat / Lagrange）数据：含 QQ 登录态，docker-compose 会在仓库根生成 ./napcat
napcat/
# 网易云登录 Cookie（MUSIC_U）等运行时数据随 /data/ 一并忽略（见下方「运行时生成的数据」）

# ===== 运行时生成的数据（本地状态，无需入库） =====
# 整目录忽略：当前生效配置(config.yaml)、歌曲库(collector.db)、网易云凭证、
# 封面缓存与榜单长图、测试样例图都在这里；模板见 config.example.yaml
/data/

# ===== 日志 =====
*.log
logs/

